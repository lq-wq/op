#!/bin/sh
# ============================================================
#  21-bandwidth —— 家庭带宽档位优化（默认 1000Mbps 档）
#   · 开启多核收发包调度（packet steering）
#   · >=500Mbps 自动开启软件流卸载（N100 轻松跑满千兆）
#   · HW_OFFLOAD=1 时连硬件流卸载一起开（需网卡支持，出问题改回 0）
# ============================================================

. /etc/device-profile

# 多核调度
uci -q set network.globals.packet_steering='1'
uci -q commit network

# 流卸载（ NAT 转发走内核快路径，千兆 CPU 占用大幅下降）
bw="${HOME_BANDWIDTH:-1000}"
case "$bw" in
	''|*[!0-9]*) bw=1000 ;;
esac

if [ "$bw" -ge 500 ]; then
	uci -q set firewall.@defaults[0].flow_offloading='1'
	if [ "$HW_OFFLOAD" = "1" ]; then
		uci -q set firewall.@defaults[0].flow_offloading_hw='1'
	else
		uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	fi
	uci -q commit firewall
fi

exit 0
