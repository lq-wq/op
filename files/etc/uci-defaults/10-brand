#!/bin/sh
# 10-brand —— 首次启动写设备身份、时区、语言、登录横幅
# 幂等脚本：每次刷机后首启执行一次，成功后自动删除

. /etc/device-profile

# ---- 主机名 / 描述 ----
uci -q set system.@system[0].hostname="$DEVICE_NAME"
uci -q set system.@system[0].description="$BRAND_NAME $BRAND_VERSION"
uci -q set system.@system[0].timezone="$TIMEZONE"
uci -q set system.@system[0].zonename="$ZONENAME"
uci -q set system.ntp.server="$NTP_SERVER"
uci -q commit system

# ---- LuCI 语言 ----
uci -q set luci.main.lang="$LANG_CODE"
uci -q commit luci

# ---- 系统版本标识（LuCI 页脚、登录页显示的名字 + 编译者签名）----
if [ -f /etc/openwrt_release ]; then
	{
		echo "DISTRIB_ID='$BRAND_NAME'"
		echo "DISTRIB_RELEASE='$BRAND_VERSION'"
		echo "DISTRIB_DESCRIPTION='$BRAND_NAME $BRAND_VERSION by $BUILDER_NAME ($BUILD_DATE) · iStoreOS 25.12 / x86_64'"
		echo "DISTRIB_VENDOR='$BRAND_VENDOR'"
		echo "DISTRIB_TARGET='x86/64'"
	} > /etc/openwrt_release
fi

# /etc/os-release 供部分程序读取，缺字段会报警，做最小覆盖
if [ -f /etc/os-release ]; then
	sed -i "s|^PRETTY_NAME=.*|PRETTY_NAME=\"$BRAND_NAME $BRAND_VERSION\"|" /etc/os-release
	sed -i "s|^NAME=.*|NAME=\"$BRAND_NAME\"|" /etc/os-release
fi

# ---- 登录横幅（含个性签名）----
cat > /etc/banner <<EOF

  $BRAND_NAME $BRAND_VERSION   ·   iStoreOS 25.12  ·   x86_64
  ------------------------------------------------------------------
  管理地址   http://$LAN_IP
  主机名     $DEVICE_NAME
  模式       $MODE
  带宽档位   ${HOME_BANDWIDTH}Mbps
  ------------------------------------------------------------------
  编译者     $BUILDER_NAME
  编译日期   $BUILD_DATE
  ------------------------------------------------------------------

  提示：设备参数集中在 /etc/device-profile，
       要永久修改请改仓库里的 device.conf 后重新编译。

EOF

exit 0
