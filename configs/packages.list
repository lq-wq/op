# 想预装什么软件，就往下加一行（只写包名，不带 CONFIG_ 前缀）
# 改完重新编译即可，无需进 menuconfig。
# 装不上的包：编译日志搜 "Package xxx is missing"，把该行删掉重编。

# ---- LuCI 基础 ----
luci
luci-theme-bootstrap
luci-app-firewall
luci-app-package-manager
luci-app-ttyd
luci-app-commands
luci-app-filetransfer
luci-app-uhttpd
luci-app-wol

# ---- 中文 ----
luci-i18n-base-zh-cn
luci-i18n-firewall-zh-cn
luci-i18n-package-manager-zh-cn
luci-i18n-ttyd-zh-cn
luci-i18n-commands-zh-cn

# ---- 存储 / 磁盘（SSD 相关，建议保留）----
parted
losetup
resize2fs
f2fs-tools
block-mount
# luci-app-diskman          # 磁盘管理界面，来自 istore feed；报缺失就注释掉

# ---- 常用工具 ----
nano
curl
wget-ssl
htop
tcpdump
iperf3
ethtool
bash

# ---- 本机要求的一批插件 ----
# 主题（kucat 设为默认，device.conf 的 THEME 控制）
luci-theme-kucat
luci-theme-argon

# iStore 应用商店（来自 istore feed）
luci-app-store
luci-i18n-store-zh-cn

# 应用过滤（oaf 对新内核兼容性一般，编译失败就注释掉这两行）
luci-app-oaf
luci-i18n-oaf-zh-cn

# Docker 管理（体积大、首次编译慢，不需要就整段注释）
luci-app-dockerman
luci-i18n-dockerman-zh-cn
docker
dockerd

# AdGuardHome（kenzok8 feed，核心随包编译，开箱即用）
luci-app-adguardhome
luci-i18n-adguardhome-zh-cn
adguardhome

# OpenClash（核心由首启脚本 50-openclash-core 自动下载）
luci-app-openclash

# UPnP
luci-app-upnp
luci-i18n-upnp-zh-cn

# ---- 网络（按需，去掉 # 即启用）----
# luci-app-ddns
# luci-app-sqm

# ---- 你自己的插件（放在 packages/ 目录里的，直接写包名）----
luci-app-hello
