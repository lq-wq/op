# =============================================================================
# iStoreOS 24.10 x86_64 软路由定制配置（最小必要集）
#
# 源码：https://github.com/istoreos/istoreos  分支 istoreos-24.10
#
# 重要说明：本配置不再沿用官方 config.seed 的全量包列表（852 项）。
#   官方全量在 4 核 runner 上编译必然超出 GitHub Actions 6 小时上限
#   （官方还启用内核 BTF + LLVM 工具链，仅编译 LLVM 就需 1.5~2.5 小时）。
#   精简后预计 2.5~3.5 小时可完成；官方更多应用可在固件内用 iStore 商店在线安装。
#
# 定制项：
#   - 目标平台：x86_64 / generic
#   - 分区大小：内核 64MB，系统 2048MB
#   - 后台管理地址：192.168.6.1（board.d 默认 IP 机制 + uci-defaults 兜底）
#   - 后台登录密码：空（首次启动 passwd -d root）
#   - 预装插件：AdGuard Home / AppFilter / DockerMan / MOMO / OpenClash /
#               iStore 商店 + Argon 主题
# =============================================================================

# ---- 目标平台 ----------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---- 分区大小（内核 64MB / 系统 2048MB）--------------------------------------
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ---- 后台管理地址 192.168.6.1 -------------------------------------------------
# 官方机制：构建阶段生成 /etc/board.d/99-lan-ip，首次启动 config_generate
# 时把默认 LAN IP 写为 192.168.6.1（files/etc/uci-defaults 中另有兜底）
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_TARGET_PREINIT_IP="192.168.6.1"

# ---- 镜像格式 -----------------------------------------------------------------
# 仅生成 squashfs-combined（系统分区只读，配置变更保存在 overlay，支持安全升级）；
# 如需"整个系统分区可写"的 ext4 镜像，取消下面注释：
# CONFIG_TARGET_ROOTFS_EXT4FS=y

# ---- GRUB ----------------------------------------------------------------------
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_TIMEOUT="1"

# ---- 编译缓存加速 ---------------------------------------------------------------
# 配合 workflow 的缓存步骤：工具链与 ccache 跨次编译复用，二次编译大幅提速
CONFIG_CCACHE=y

# ---- LuCI 基础 ------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# ---- 中文界面 --------------------------------------------------------------------
# jjm2473 fork 的 luci feed 无全局 LUCI_LANG 符号，需显式选择各应用的中文语言包
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-admin-full-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-momo-zh-cn=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---- 必装插件（按需求列表）-------------------------------------------------------
# AdGuard Home（24.10 的 luci feed 无此应用，由本项目 packages/luci-app-adguardhome
#               内置提供；diy-part1.sh 会将其复制进源码树 package/ 目录）
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y

# AppFilter 应用过滤（jjm2473/OpenAppFilter dev7 feed，包名为 luci-app-oaf）
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# DockerMan（jjm2473/luci feed 提供 luci-app-dockerman）
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_docker-compose=y

# MOMO（sing-box 图形界面，nikkinikki-org/OpenWrt-momo feed）
CONFIG_PACKAGE_luci-app-momo=y
CONFIG_PACKAGE_momo=y
CONFIG_PACKAGE_sing-box=y

# OpenClash（vernesong/OpenClash master feed；依赖 dnsmasq-full/kmod-tun 等
#            会由依赖关系自动带入）
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y

# iStore 应用商店（linkease/istore feed）
CONFIG_PACKAGE_luci-app-store=y

# ---- 主题 ------------------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---- 常用插件 ----------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-ddns=y

# ---- 网络增强 ----------------------------------------------------------------------
# WireGuard
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
