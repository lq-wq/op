# =============================================================================
# iStoreOS 24.10 分支 feeds 配置
#
# 基础部分与 iStoreOS 官方构建保持一致：
#   - feeds.conf.default（istoreos-24.10 分支自带）
#   - 官方构建附加 feeds（fw.koolcenter.com 官方 config.seed 同款）
# 新增部分：momo、openclash
# =============================================================================

# ---- 官方基础 feeds（istoreos-24.10 分支 feeds.conf.default）-------------------
src-git packages https://github.com/jjm2473/packages.git;istoreos-24.10
src-git luci https://github.com/jjm2473/luci.git;istoreos-24.10
src-git routing https://github.com/openwrt/routing.git;openwrt-24.10
src-git telephony https://github.com/openwrt/telephony.git;openwrt-24.10
# istore 应用商店
src-git store https://github.com/linkease/istore.git;main
# argon 主题等（含 git 子模块，scripts/feeds 会自动递归初始化）
src-git third https://github.com/jjm2473/openwrt-third.git;main

# ---- 官方构建附加 feeds ---------------------------------------------------------
src-git third_party https://github.com/linkease/istore-packages.git;main
src-git diskman https://github.com/jjm2473/luci-app-diskman.git;dev
src-git oaf https://github.com/jjm2473/OpenAppFilter.git;dev7
src-git linkease_nas https://github.com/linkease/nas-packages.git;master
src-git linkease_nas_luci https://github.com/linkease/nas-packages-luci.git;main
src-git jjm2473_apps https://github.com/jjm2473/openwrt-apps.git;main

# ---- 本项目新增 -------------------------------------------------------------------
# MOMO（sing-box 图形界面）
src-git momo https://github.com/nikkinikki-org/OpenWrt-momo.git;main
# OpenClash
src-git openclash https://github.com/vernesong/OpenClash.git;master

# 注意：luci-app-adguardhome 不在以上任何 feed 中，
#       由本项目 packages/luci-app-adguardhome 内置（构建脚本复制进源码树）。
