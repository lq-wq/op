#!/bin/sh
# 11-theme —— 首启启用默认主题（device.conf 的 THEME）
# kucat / argon 来自第三方 feed；bootstrap 是系统自带

. /etc/device-profile

case "$THEME" in
	argon)     base='/luci-static/argon' ;;
	kucat)     base='/luci-static/kucat' ;;
	bootstrap) base='/luci-static/bootstrap' ;;
	*) exit 0 ;;
esac

# 主题没装上时不要把 LuCI 弄挂：确认资源目录存在再切
if [ -d "/www${base}" ]; then
	uci -q set luci.main.mediaurlbase="$base"
	uci -q commit luci
fi

exit 0
