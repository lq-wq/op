#!/bin/sh
# ============================================================
#  40-root-nopasswd —— 登录密码策略
#    device.conf 里 ROOT_PASSWORD 留空  -> root 无密码（你要的）
#    device.conf 里写了值               -> 用该值作为 root 密码
# ============================================================

. /etc/device-profile

if [ -n "$ROOT_PASSWORD" ]; then
	printf '%s\n%s\n' "$ROOT_PASSWORD" "$ROOT_PASSWORD" | passwd root >/dev/null 2>&1
else
	# 把 /etc/shadow 里 root 的密码哈希清空 = 空密码
	sed -i 's|^root:[^:]*:|root::|' /etc/shadow
fi

# SSH 放行 root 登录与密码认证（空密码机型必须打开，否则只能走 Web）
uci -q set dropbear.@dropbear[0].PasswordAuth='on'
uci -q set dropbear.@dropbear[0].RootPasswordAuth='on'
uci -q set dropbear.@dropbear[0].RootLogin='1'
uci -q commit dropbear

# 提示写入 motd，便于以后想起来
if [ -z "$ROOT_PASSWORD" ]; then
	echo "提示：当前 root 为空密码（内网自用）。要设密码执行： passwd root" >> /etc/motd
fi

exit 0
